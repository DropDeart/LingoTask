{
  "name": "lingotask",
  "version": "1.0.0",
  "description": "IELTS 6.5 calisma uygulamasi",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "electron build-icons.js",
    "build:web": "node build-web.js",
    "serve:web": "node serve-web.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "LingoTask",
  "author": {
    "name": "Furkan Recep Cinar",
    "email": "DropDeart@users.noreply.github.com"
  },
  "license": "MIT",
  "build": {
    "appId": "dev.lingotask.app",
    "productName": "LingoTask",
    "copyright": "LingoTask",
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon-512.png",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LingoTask",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LingoTask-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "LingoTask-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "public.app-category.education",
      "artifactName": "LingoTask-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "LingoTask ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "Education",
      "synopsis": "IELTS study app",
      "artifactName": "LingoTask-${version}-${arch}.${ext}",
      "desktopName": "lingotask.desktop",
      "maintainer": "Furkan Recep Cinar <DropDeart@users.noreply.github.com>",
      "description": "Vocabulary, grammar, reading, listening, writing and speaking practice for IELTS, with an offline mode."
    },
    "asarUnpack": [
      "src/main/tts.ps1"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DropDeart",
        "repo": "LingoTask"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
